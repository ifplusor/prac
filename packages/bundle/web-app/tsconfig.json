{
  "compilerOptions": {
    "target": "esnext",
    // DOM is the target plane: the arrangement half reads the document and
    // binds keys. The DSH client boundary and `react` are declared locally in
    // src/dsh.d.ts, so node globals must not leak into this browser plane.
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
