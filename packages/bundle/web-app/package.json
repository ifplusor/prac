{
  "name": "prac-web-app",
  "version": "0.0.0",
  "description": "The prac bundle: its cordis.patch.yml is the composition (frame mechanism + VS Code side), and its client half is the arrangement — the default views and their placements, the role binding, the window groups and the keybindings.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "prac-client-ui-document-preview": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "prac-client-dsh-host": "workspace:*",
    "prac-client-ui-deliverables": "workspace:*",
    "prac-client-ui-frame": "workspace:*",
    "prac-client-ui-vscode-editor": "workspace:*",
    "prac-client-ui-vscode-views": "workspace:*",
    "prac-client-ui-widget": "workspace:*",
    "prac-client-ui-workbench": "workspace:*",
    "prac-client-vscode-host": "workspace:*",
    "prac-host-vscode": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
