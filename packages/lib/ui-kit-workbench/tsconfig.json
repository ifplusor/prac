{
  "compilerOptions": {
    "target": "esnext",
    // DOM is the target plane: this engine measures regions and owns elements.
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // No ambient @types: the DSH boundary and `react` are declared locally, so
    // node globals must not leak into this browser plane.
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
