{
  "name": "prac-ui-kit",
  "version": "0.0.0",
  "private": false,
  "description": "Framework-agnostic layout, surface and binding kernel for prac and other UI projects.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.mts",
      "default": "./dist/geometry.mjs"
    },
    "./surface": {
      "types": "./dist/surface.d.mts",
      "default": "./dist/surface.mjs"
    },
    "./binding": {
      "types": "./dist/binding.d.mts",
      "default": "./dist/binding.mjs"
    },
    "./package.json": "./package.json",
    "./allocation": {
      "types": "./dist/allocation.d.mts",
      "default": "./dist/allocation.mjs"
    },
    "./tree": {
      "types": "./dist/tree.d.mts",
      "default": "./dist/tree.mjs"
    },
    "./grid": {
      "types": "./dist/grid.d.mts",
      "default": "./dist/grid.mjs"
    },
    "./view": {
      "types": "./dist/view.d.mts",
      "default": "./dist/view.mjs"
    },
    "./viewGroup": {
      "types": "./dist/viewGroup.d.mts",
      "default": "./dist/viewGroup.mjs"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.mts",
      "default": "./dist/snapshot.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run"
  }
}
