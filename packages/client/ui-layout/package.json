{
  "name": "prac-client-ui-layout",
  "version": "0.0.0",
  "private": true,
  "description": "prac's React frame and plugin body; geometry and runtime contracts live in prac-client-ui-frame.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run --passWithNoTests"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-session": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "prac-client-ui-frame": "workspace:*",
    "prac-client-ui-surface": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  }
}
