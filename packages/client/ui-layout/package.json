{
  "name": "prac-client-ui-layout",
  "version": "0.0.0",
  "private": true,
  "description": "prac's layout mechanism: a generic multi-region frame where every view can be placed in any region. Owns the frame, region tree, sashes, collapse, the view catalogue, the `prac.view` seat, `ctx.pracLayout` and the borrowed `ctx.layout` compat shim — and no concrete view name or default placement.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-session": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  }
}
