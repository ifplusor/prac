{
  "compilerOptions": {
    "target": "esnext",
    // DOM is the target plane: the client half writes styles, titles and meta tags.
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // No ambient @types: the DSH boundary and `react` are declared locally in
    // src/dsh.d.ts, so node globals must not leak into this browser plane.
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
