{
  "name": "prac-client-ui-vscode-views",
  "version": "0.0.0",
  "private": true,
  "description": "The VS Code views seat: declares one `prac.view` per view the app's view registry reports (core contributions and extension-contributed views alike), through the shared mechanism from `prac-client-vscode-host`. Boots nothing.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@types/react": "catalog:",
    "prac-client-ui-layout": "workspace:*",
    "prac-client-vscode-host": "workspace:*",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  }
}
