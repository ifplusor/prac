{
  "name": "prac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "test": "vp run -r test --passWithNoTests",
    "check": "vp check . && node scripts/dsh-types.mjs --compare",
    "dsh-types": "node scripts/dsh-types.mjs",
    "verify:stack": "node tests/gates/verify-stack.mjs",
    "verify:bottom": "node tests/gates/verify-bottom.mjs",
    "verify:containers": "node tests/gates/verify-containers.mjs",
    "verify:persistence": "node tests/gates/verify-persistence.mjs",
    "verify:split": "node tests/gates/verify-split.mjs",
    "verify:resize": "node tests/gates/verify-resize.mjs",
    "verify:dynamic": "node tests/gates/verify-dynamic.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
