# Machine state, build-time only: the vendored VS Code checkout (vscode/) and
# one-off developer outputs (scratch/). Both can be regenerated, so this root is
# disposable by design. Run-time state is NOT here -- it follows XDG and lives
# outside the repository (see vendor/vscode/README.md, 目录规范).
.build/

# Dependencies
node_modules/

# Build outputs
dist/
build/
lib/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Local memory / indexes / embeddings
.memory/
.index/
data/

# Python (legacy reference, kept out of the new TS project)
__pycache__/
*.pyc
.venv/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
