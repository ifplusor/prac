# Machine state: build (vscode/), run-time (run/), caches (cache/), scratch.
# Everything the build and the services write lives under this one root, so the
# repository root stays source-only and the whole thing is disposable by design
# (see vendor/vscode/README.md, 目录规范).
.build/

# Dependencies
node_modules/

# Build outputs
dist/
build/
lib/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Local memory / indexes / embeddings
.memory/
.index/
data/

# Python (legacy reference, kept out of the new TS project)
__pycache__/
*.pyc
.venv/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
