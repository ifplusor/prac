diff --git a/src/vs/workbench/contrib/webview/browser/overlayWebview.ts b/src/vs/workbench/contrib/webview/browser/overlayWebview.ts
index ad4e4e14..b75dc178 100644
--- a/src/vs/workbench/contrib/webview/browser/overlayWebview.ts
+++ b/src/vs/workbench/contrib/webview/browser/overlayWebview.ts
@@ -122,8 +122,15 @@ export class OverlayWebview extends Disposable implements IOverlayWebview {
 
 			// Webviews cannot be reparented in the dom as it will destroy their contents.
 			// Mount them to a high level node to avoid this depending on the active container.
-			const root = this._layoutService.getContainer(this.window);
-			root.appendChild(this._overlayLayout.root);
+			//
+			// prac: the embedder owns the layout, so a view pane can live *outside*
+			// `.monaco-workbench` — and a webview positions itself over its pane's
+			// body with CSS anchor positioning, which does not resolve across that
+			// subtree boundary (measured: the same element resolves to the anchor's
+			// box from `document.body`, and to 0x0 from inside the workbench root).
+			// The document body is the common ancestor of both, so the overlay goes
+			// there; the workbench container stays what it was for everything else.
+			this.window.document.body.appendChild(this._overlayLayout.root);
 		}
 
 		return this._overlayLayout;
