{
  "compilerOptions": {
    "target": "esnext",
    // Both halves are checked here: the host half is Node code, the browser half
    // is DOM + React code, and neither is a DSH plugin body (the rows that
    // consume them live in `packages/`).
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
